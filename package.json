{
  "name": "menu-akinator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "data": "tsx scripts/build-data.ts",
    "dev": "npm run data -- --quiet && vite --host",
    "build": "npm run data -- --quiet && tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "sim": "npm run data && tsx scripts/simulate.ts",
    "analyze": "tsx scripts/analyze-results.ts",
    "experiments": "tsx scripts/experiments.ts"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.4",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "preact": "^10.29.8"
  },
  "engines": {
    "node": ">=20"
  }
}
